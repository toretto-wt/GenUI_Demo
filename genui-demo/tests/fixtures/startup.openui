root = Card([header, tabs, metricsTitle, metrics, goal, followUps])
header = CardHeader("Startup analytics", "Q1 2026 | Illustrative sample data")
tabs = Tabs([revenueTab, growthTab, breakdownTab], "")
revenueTab = TabItem("rev", "Revenue", [revenue])
growthTab = TabItem("growth", "Growth", [growth])
breakdownTab = TabItem("breakdown", "Breakdown", [breakdown])
revenue = BarChart(["Jan", "Feb", "Mar", "Apr", "May", "Jun"], [Series("Subscriptions", [42, 48, 54, 61, 69, 78]), Series("Services", [18, 21, 24, 27, 31, 34])], "grouped", "Month", "Revenue ($k)")
growth = LineChart(["Jan", "Feb", "Mar", "Apr", "May", "Jun"], [Series("Active users", [1200, 1460, 1810, 2200, 2700, 3250]), Series("New users", [260, 340, 460, 510, 620, 780])], "Month", "Users")
breakdown = PieChart([Slice("Organic", 42), Slice("Direct", 28), Slice("Referral", 18), Slice("Paid", 12)], true)
metricsTitle = Heading("Key metrics", "h3")
metrics = Table([Col("Metric"), Col("Current"), Col("Change")], [["MRR", "$112,000", "+14.8%"], ["Active users", "3,250", "+20.4%"], ["Churn rate", "2.1%", "-0.4 pp"]])
goal = Progress(64, "Annual revenue goal")
followUps = FollowUpBlock([FollowUpItem("Compare this quarter with last year"), FollowUpItem("Break down revenue by region")])
